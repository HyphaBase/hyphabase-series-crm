# The API URL for your HyphaBase account (shown in the console).
HYPHABASE_API_URL=

# A secret key from the console with these scopes:
#   data.collections.manage   define the Customers collection
#   data.records.create       add customers
#   data.records.read         read them back
#   users.create              create the people who can sign in (episode 3)
#   users.view                find a user by email, to give them a role (episode 4)
#   roles.view, roles.create  define the Owner and Staff roles (episode 4)
#   roles.assign              give a user a role (episode 4)
#   data.records.delete       delete customers, for the people allowed to (episode 4)
#   users.delete              optional: lets `npm run smoke` remove the test users it creates
# From episode 3 the key also needs access to your location: on the API keys
# page, open the key's access settings and tick the location.
# Secret keys are server-side only. Never commit one or ship one to a browser.
HYPHABASE_SECRET_KEY=sk_test_...

# The id of the location your users belong to (Locations page). Episode 3 on.
HYPHABASE_LOCATION_ID=
