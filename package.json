{
  "name": "hyphabase-series-crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build a CRM with HyphaBase - the example app from the series, one tagged checkpoint per episode",
  "license": "MIT",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "setup": "node --env-file=.env src/setup.js",
    "customer:add": "node --env-file=.env src/add-customer.js",
    "customer:list": "node --env-file=.env src/list-customers.js",
    "user:add": "node --env-file=.env src/add-user.js",
    "roles:setup": "node --env-file=.env src/setup-roles.js",
    "role:give": "node --env-file=.env src/give-role.js",
    "serve": "node --env-file=.env src/serve.js",
    "crm:signin": "node src/crm-signin.js",
    "crm:customers": "node src/crm-customers.js",
    "crm:me": "node src/crm-me.js",
    "crm:delete": "node src/crm-delete.js",
    "crm:signout": "node src/crm-signout.js",
    "web": "npm --prefix web run dev",
    "web:test": "npm --prefix web test",
    "test": "node --test test/*.test.js",
    "smoke": "node --env-file=.env --test test/smoke.js test/smoke-auth.js test/smoke-roles.js",
    "smoke:web": "npm --prefix web run build && node --env-file=.env --test test/smoke-web.js"
  }
}
